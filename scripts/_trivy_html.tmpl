{{/* ==============================================================================
   Template HTML custom para trivy (proyecto genai-secure-cicd-pipeline).
   Genera un report legible de vulnerabilidades y misconfiguraciones.
   El gate y la trazabilidad se resuelven afuera: run-trivy.sh interpola los
   placeholders __IMAGE_NAME__ / __IMAGE_DIGEST__ / __BUILD_COMMIT__ /
   __SCAN_TIMESTAMP__ / __SEVERITY_THRESHOLD__ con sed tras la generacion.
   Datos del template: array de Results (igual que contrib/html.tpl oficial),
   por eso range . itera los resultados y cada Result tiene .Vulnerabilities
   y .Misconfigurations. Trivy exige extension .tpl en --template @file:
   run-trivy.sh copia este archivo a un temporal .tpl antes de invocarlo.
   Referencia: https://github.com/aquasecurity/trivy/blob/main/contrib/html.tpl
   ============================================================================== */}}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>Trivy Report - __IMAGE_NAME__</title>
  <style>
    * { font-family: Arial, Helvetica, sans-serif; }
    body { margin: 2em; }
    h1 { text-align: center; }
    table { border-collapse: collapse; margin: 1em auto; width: 100%; }
    th, td { border: 1px solid #444; padding: .4em; text-align: left; }
    tr.sev-CRITICAL td { background: #e40000; color: #fafafa; }
    tr.sev-HIGH td { background: #ff8800; }
    tr.sev-MEDIUM td { background: #e9c600; }
    tr.sev-LOW td { background: #5fbb31; }
    tr.sev-UNKNOWN td { background: #747474; color: #fafafa; }
    .trace { text-align: center; font-size: .9em; color: #555; }
  </style>
</head>
<body>
  <h1>Trivy Security Report</h1>
  <p class="trace">
    Image: <strong>__IMAGE_NAME__</strong> &mdash;
    Digest: <strong>__IMAGE_DIGEST__</strong> &mdash;
    Commit: <strong>__BUILD_COMMIT__</strong> &mdash;
    Scan: <strong>__SCAN_TIMESTAMP__</strong> &mdash;
    Gate (rompe-build): <strong>__SEVERITY_THRESHOLD__</strong>
  </p>
{{- if . }}
  {{- range . }}
  <h2>{{ .Type | toString | escapeXML }} &mdash; {{ escapeXML .Target }}</h2>
  {{- if .Vulnerabilities }}
  <table>
    <tr>
      <th>Package</th>
      <th>Vulnerability ID</th>
      <th>Severity</th>
      <th>Installed</th>
      <th>Fixed</th>
      <th>Title</th>
    </tr>
    {{- range .Vulnerabilities }}
    <tr class="sev-{{ escapeXML .Vulnerability.Severity }}">
      <td>{{ escapeXML .PkgName }}</td>
      <td>{{ escapeXML .VulnerabilityID }}</td>
      <td>{{ escapeXML .Vulnerability.Severity }}</td>
      <td>{{ escapeXML .InstalledVersion }}</td>
      <td>{{ escapeXML .FixedVersion }}</td>
      <td>{{ escapeXML .Title }}</td>
    </tr>
    {{- end }}
  </table>
  {{- else }}
  <p>No vulnerabilities found.</p>
  {{- end }}
  {{- if .Misconfigurations }}
  <table>
    <tr>
      <th>Type</th>
      <th>Misconf ID</th>
      <th>Check</th>
      <th>Severity</th>
      <th>Message</th>
    </tr>
    {{- range .Misconfigurations }}
    <tr class="sev-{{ escapeXML .Severity }}">
      <td>{{ .Type | toString | escapeXML }}</td>
      <td>{{ escapeXML .ID }}</td>
      <td>{{ escapeXML .Title }}</td>
      <td>{{ escapeXML .Severity }}</td>
      <td style="white-space:normal;">{{ escapeXML .Message }}</td>
    </tr>
    {{- end }}
  </table>
  {{- else }}
  <p>No misconfigurations found.</p>
  {{- end }}
  {{- end }}
{{- else }}
  <p>Trivy returned an empty report.</p>
{{- end }}
</body>
</html>